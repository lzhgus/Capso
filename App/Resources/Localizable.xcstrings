    "System audio stopped being captured. The rest of the recording may have no sound." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemaudio wird nicht mehr aufgezeichnet. Der Rest der Aufzeichnung hat möglicherweise keinen Ton."
