          }
        }
      }
    },
    "The storage provider rejected the credentials. Verify the access key, secret, and bucket permissions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Speicheranbieter hat die Zugangsdaten abgelehnt. Prüfe Access Key, Secret und Bucket-Berechtigungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El proveedor de almacenamiento ha rechazado las credenciales. Comprueba la clave de acceso, el secreto y los permisos del bucket."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fournisseur de stockage a refusé les identifiants. Vérifiez la clé d'accès, le secret et les autorisations du bucket."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il provider di archiviazione ha rifiutato le credenziali. Verifica chiave di accesso, secret e permessi del bucket."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストレージプロバイダが認証情報を拒否しました。アクセスキー、シークレット、バケットの権限を確認してください。"
