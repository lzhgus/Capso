    "The bucket isn't publicly readable. Open the Cloudflare dashboard → your bucket → Settings, then enable Public Development URL or add a Custom Domain. Then re-test." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Bucket ist nicht öffentlich lesbar. Öffne Cloudflare-Dashboard → dein Bucket → Settings und aktiviere „Public Development URL“ oder füge eine „Custom Domain“ hinzu. Teste dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El bucket no se puede leer públicamente. Abre el panel de Cloudflare → tu bucket → Settings y activa Public Development URL o añade un Custom Domain. Después, vuelve a probar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bucket n'est pas lisible publiquement. Ouvrez le tableau de bord Cloudflare → votre bucket → Settings, puis activez Public Development URL ou ajoutez un Custom Domain. Testez ensuite à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il bucket non è leggibile pubblicamente. Apri la dashboard di Cloudflare → il tuo bucket → Settings, poi attiva Public Development URL o aggiungi un Custom Domain. Quindi ripeti il test."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バケットが公開読み取り可能になっていません。Cloudflare ダッシュボード → バケット → Settings を開き、Public Development URL を有効にするか Custom Domain を追加してください。その後、再テストしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "버킷이 공개적으로 읽을 수 없습니다. Cloudflare 대시보드 → 버킷 → Settings를 열고 Public Development URL을 활성화하거나 Custom Domain을 추가하세요. 그런 다음 다시 테스트하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O bucket não pode ser lido publicamente. Abra o painel do Cloudflare → seu bucket → Settings e ative Public Development URL ou adicione um Custom Domain. Depois, teste novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бакет недоступен для публичного чтения. Откройте панель управления Cloudflare → ваш бакет → Settings, включите Public Development URL или добавьте Custom Domain. Затем проверьте снова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bucket 当前不可公开读取。打开 Cloudflare 控制台 → 你的 bucket → Settings，然后启用 Public Development URL 或添加 Custom Domain。然后重新测试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存貯體目前無法公開讀取。請打開 Cloudflare 控制台 → 你的儲存貯體 → Settings，然後啟用 Public Development URL 或加入 Custom Domain，再重新測試。"
          }
        }
      }
    },
    "The bucket needs Public access enabled. Open the Cloudflare dashboard → your bucket → Settings → Public access, then re-test." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für den Bucket muss „Public access“ aktiviert sein. Öffne Cloudflare-Dashboard → dein Bucket → Settings → Public access und teste dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El bucket necesita tener Public access activado. Abre el panel de Cloudflare → tu bucket → Settings → Public access y vuelve a probar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Public access doit être activé sur le bucket. Ouvrez le tableau de bord Cloudflare → votre bucket → Settings → Public access, puis testez à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il bucket deve avere l'accesso pubblico attivo. Apri la dashboard di Cloudflare → il tuo bucket → Settings → Public access, poi ripeti il test."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バケットの Public access を有効にする必要があります。Cloudflare ダッシュボード → バケット → Settings → Public access を開いて、再テストしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "버킷에 Public access를 활성화해야 합니다. Cloudflare 대시보드 → 버킷 → Settings → Public access를 열고 다시 테스트하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O bucket precisa ter o Public access ativado. Abra o painel do Cloudflare → seu bucket → Settings → Public access e teste novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для бакета нужно включить Public access. Откройте панель управления Cloudflare → ваш бакет → Settings → Public access, затем проверьте снова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要为存储桶启用 Public access。请打开 Cloudflare 控制台 → 存储桶 → Settings → Public access，然后重新测试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存貯體需要啟用 Public access。請打開 Cloudflare 控制台 → 你的儲存貯體 → Settings → Public access，然後重新測試。"
          }
        }
      }
    },
    "The bucket URL is not publicly readable. Enable public access or use a public custom domain, then re-test." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
