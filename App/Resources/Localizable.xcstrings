        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Capso foi encerrado inesperadamente durante uma gravação. O que foi gravado foi salvo em %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
