    "`R2 → Manage API Tokens` → `Create API Token`. Choose **Object Read & Write**, scoped to this bucket." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`R2 → Manage API Tokens` → `Create API Token`. Wähle **Object Read & Write**, beschränkt auf diesen Bucket."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`R2 → Manage API Tokens` → `Create API Token`. Elige **Object Read & Write**, limitado a este bucket."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`R2 → Manage API Tokens` → `Create API Token`. Choisissez **Object Read & Write**, limité à ce bucket."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`R2 → Manage API Tokens` → `Create API Token`. Scegli **Object Read & Write**, limitato a questo bucket."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`R2 → Manage API Tokens` → `Create API Token`。**Object Read & Write** を選び、このバケットにスコープします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`R2 → Manage API Tokens` → `Create API Token`으로 이동하세요. **Object Read & Write**를 선택하고 이 버킷으로 범위를 제한하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`R2 → Manage API Tokens` → `Create API Token`. Escolha **Object Read & Write**, limitado a este bucket."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`R2 → Manage API Tokens` → `Create API Token`. Выберите **Object Read & Write** с доступом только к этому бакету."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`R2 → Manage API Tokens` → `Create API Token`。选择 **Object Read & Write**，并限定到这个存储桶。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`R2 → Manage API Tokens` → `Create API Token`。選擇 **Object Read & Write**，並將範圍限定於此儲存貯體。"
          }
        }
      }
