        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스토리지 제공업체가 자격 증명을 거부했습니다. 액세스 키, 시크릿, 버킷 권한을 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O provedor de armazenamento rejeitou as credenciais. Verifique a chave de acesso, o segredo e as permissões do bucket."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Провайдер хранилища отклонил учетные данные. Проверьте ключ доступа, секретный ключ и права доступа к бакету."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
