            "state" : "translated",
            "value" : "Votre compte de stockage a atteint sa limite. Libérez de l'espace ou passez à une offre supérieure chez votre fournisseur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'account di archiviazione ha raggiunto il limite. Libera spazio o passa a un piano superiore del provider."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストレージアカウントが上限に達しています。空き容量を確保するか、プロバイダのプランをアップグレードしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
