    "Use a public bucket URL or connect a custom domain/CDN. Capso needs a public HTTPS prefix so it can copy a share link." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende eine öffentliche Bucket-URL oder verbinde eine eigene Domain/ein CDN. Capso braucht ein öffentliches HTTPS-Präfix, um einen Freigabelink kopieren zu können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa una URL pública del bucket o conecta un dominio personalizado/CDN. Capso necesita un prefijo HTTPS público para poder copiar un enlace para compartir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez une URL de bucket publique ou connectez un domaine personnalisé/CDN. Capso a besoin d'un préfixe HTTPS public pour copier un lien de partage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un URL pubblico del bucket o collega un dominio personalizzato/CDN. Capso ha bisogno di un prefisso HTTPS pubblico per copiare un link di condivisione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公開バケット URL を使用するか、カスタムドメイン/CDN を接続してください。共有リンクをコピーするには、Capso に公開 HTTPS プレフィックスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공개 버킷 URL을 사용하거나 사용자 지정 도메인/CDN을 연결하세요. 공유 링크를 복사하려면 Capso에 공개 HTTPS 접두사가 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use um URL público do bucket ou conecte um domínio personalizado/CDN. O Capso precisa de um prefixo HTTPS público para copiar um link de compartilhamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте публичный URL бакета или подключите собственный домен/CDN. Capso нужен публичный HTTPS-префикс, чтобы копировать ссылку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请使用存储桶的公开 URL，或连接自定义域名/CDN。Capso 需要公开的 HTTPS 前缀才能复制分享链接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請使用儲存貯體的公開 URL，或連接自訂網域／CDN。Capso 需要公開的 HTTPS 前綴才能拷貝分享連結。"
          }
        }
      }
    },
