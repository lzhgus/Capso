    "KeyCastr-style overlay of keys while recording. Requires Input Monitoring. Off by default." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasten-Overlay im KeyCastr-Stil beim Aufzeichnen. Erfordert Eingabeüberwachung. Standardmäßig aus."
          }
        },
        "es" : {
          "stringUnit" : {
