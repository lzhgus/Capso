    "Hold ⌘ while dragging to disable temporarily." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte beim Ziehen ⌘ gedrückt, um dies vorübergehend zu deaktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado ⌘ al arrastrar para desactivarlo temporalmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez ⌘ pendant le glissement pour désactiver temporairement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto ⌘ durante il trascinamento per disattivare temporaneamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグ中に ⌘ を押すと一時的に無効化。"
