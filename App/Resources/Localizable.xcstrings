    "Hold Shift for 1:1, then this extra key to grow from the click as the center. Shift cannot be changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die Umschalttaste für 1:1 und dann diese Zusatztaste, um vom Klickpunkt aus zentriert aufzuziehen. Die Umschalttaste kann nicht geändert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada Mayúsculas para 1:1 y luego esta tecla adicional para ampliar desde el clic como centro. Mayúsculas no se puede cambiar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez Maj pour le 1:1, puis cette touche supplémentaire pour agrandir à partir du clic comme centre. Maj ne peut pas être modifiée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto Maiusc per 1:1, poi questo tasto aggiuntivo per espandere dal punto del clic come centro. Maiusc non può essere modificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shiftで1:1に固定し、この追加キーで最初のクリックを中心に拡大します。Shiftは変更できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shift로 1:1을 유지한 뒤, 이 추가 키로 첫 클릭을 중심으로 키웁니다. Shift는 바꿀 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha Shift pressionado para 1:1 e depois esta tecla extra para expandir a partir do clique como centro. Shift não pode ser alterado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте Shift для пропорции 1:1, а затем эту дополнительную клавишу, чтобы область расширялась от точки нажатия как от центра. Shift изменить нельзя."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住 Shift 锁定 1:1，再按此附加键从点击处居中扩展。Shift 无法更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住 Shift 鎖定 1:1，再按此附加按鍵以點按處為中心擴展。Shift 無法更改。"
          }
        }
      }
    },
    "Hold ⌘ while dragging to disable temporarily." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte beim Ziehen ⌘ gedrückt, um dies vorübergehend zu deaktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado ⌘ al arrastrar para desactivarlo temporalmente."
          }
        },
        "fr" : {
