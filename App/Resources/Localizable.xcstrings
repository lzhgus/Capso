    "Upload worked, but the file isn't publicly reachable. Enable Public access on the bucket in Cloudflare." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upload hat funktioniert, aber die Datei ist nicht öffentlich erreichbar. Aktiviere „Public access“ für den Bucket in Cloudflare."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha subido, pero el archivo no es accesible públicamente. Activa Public access en el bucket de Cloudflare."
