        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El audio del sistema ha dejado de capturarse. Puede que el resto de la grabación no tenga sonido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'audio système n'est plus capturé. Le reste de l'enregistrement risque d'être sans son."
