    "Saving the %@ to %@ failed. The recording is still available in the preview — close this dialog and try Save again, or use Copy." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichern von %@ unter %@ fehlgeschlagen. Die Aufzeichnung ist weiterhin in der Vorschau verfügbar – schließe diesen Dialog und versuche erneut „Sichern“ oder verwende „Kopieren“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Saving the %1$@ to %2$@ failed. The recording is still available in the preview — close this dialog and try Save again, or use Copy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido guardar %1$@ en %2$@. La grabación sigue disponible en la vista previa: cierra este cuadro de diálogo y vuelve a probar Guardar, o usa Copiar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'enregistrement de %@ dans %@ a échoué. L'enregistrement est toujours disponible dans l'aperçu — fermez cette fenêtre et réessayez Enregistrer, ou utilisez Copier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile salvare %1$@ in %2$@. La registrazione è ancora disponibile nell'anteprima: chiudi questa finestra e riprova Salva, oppure usa Copia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を %@ に保存できませんでした。録画はプレビューに残っています。このダイアログを閉じてもう一度保存するか、コピーを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을(를) %@에 저장하지 못했습니다. 녹화는 미리보기에서 계속 사용할 수 있습니다. 이 대화상자를 닫고 다시 저장하거나 복사를 사용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível salvar o %@ em %@. A gravação continua disponível na pré-visualização — feche esta caixa de diálogo e tente Salvar novamente, ou use Copiar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сохранить %@ в %@. Запись по-прежнему доступна в предпросмотре — закройте это окно и снова нажмите «Сохранить» или используйте «Скопировать»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法将%@保存到 %@。录制内容仍可在预览中使用 — 请关闭此对话框后再次尝试保存，或使用复制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
