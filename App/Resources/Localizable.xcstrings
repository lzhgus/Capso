    "Useful for capturing menus, hover states, and other UI that disappears the moment you move the mouse." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praktisch für Menüs, Hover-Zustände und andere Elemente, die verschwinden, sobald du die Maus bewegst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Útil para capturar menús, estados al pasar el puntero y otros elementos de la interfaz que desaparecen en cuanto mueves el ratón."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratique pour capturer les menus, les états de survol et les autres éléments d'interface qui disparaissent dès que vous déplacez la souris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utile per catturare menu, stati al passaggio del mouse e altri elementi che scompaiono appena muovi il mouse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニュー、ホバー状態、マウスを動かすと消えるUIの撮影に便利です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴, 호버 상태, 마우스를 움직이면 사라지는 UI를 캡처할 때 유용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Útil para capturar menus, estados de hover e outros elementos que desaparecem assim que você move o mouse."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удобно для съемки меню, состояний при наведении и других элементов, которые исчезают, как только вы двигаете мышь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适合捕捉菜单、悬停状态，以及鼠标一移动就会消失的界面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "適合擷取選單、滑鼠懸停狀態，以及其他一移動滑鼠就會消失的介面。"
          }
        }
      }
    },
    "Uses the background, padding, corners and shadow last set in the editor's Beautify panel" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet Hintergrund, Abstand, Ecken und Schatten, die zuletzt im Bereich „Verschönern“ des Editors eingestellt wurden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el fondo, el margen, las esquinas y la sombra definidos por última vez en el panel Embellecer del editor"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise l'arrière-plan, la marge, les coins et l'ombre définis en dernier dans le panneau Embellir de l'éditeur"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa lo sfondo, il margine, gli angoli e l'ombra impostati per ultimi nel pannello Abbellisci dell'editor"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エディタの美化パネルで最後に設定した背景、余白、角丸、影を使用します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편집기의 꾸미기 패널에서 마지막으로 설정한 배경, 여백, 모서리, 그림자를 사용합니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa o fundo, a margem, os cantos e a sombra definidos por último no painel Embelezar do editor"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используются фон, отступы, углы и тень, заданные последними на панели «Оформление» в редакторе"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用编辑器美化面板中最近设置的背景、边距、圆角和阴影"
          }
        },
        "zh-Hant" : {
