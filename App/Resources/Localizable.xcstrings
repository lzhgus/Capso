          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Они хранятся в Связке ключей macOS на этом Mac и никуда не отправляются, кроме вашего бакета."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些信息存储在此 Mac 的 macOS 钥匙串中，除您的存储桶外不会发送到任何地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
