    "The recording was stopped and saved to prevent data loss. Free up disk space before recording again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufzeichnung wurde gestoppt und gesichert, um Datenverlust zu vermeiden. Gib Speicherplatz frei, bevor du erneut aufzeichnest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grabación se ha detenido y guardado para evitar perder datos. Libera espacio en disco antes de volver a grabar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'enregistrement a été arrêté et sauvegardé pour éviter toute perte de données. Libérez de l'espace disque avant d'enregistrer à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La registrazione è stata interrotta e salvata per evitare la perdita di dati. Libera spazio su disco prima di registrare di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データの損失を防ぐため、録画を停止して保存しました。再度録画する前にディスクの空き容量を確保してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터 손실을 방지하기 위해 녹화를 중지하고 저장했습니다. 다시 녹화하기 전에 디스크 공간을 확보하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gravação foi interrompida e salva para evitar perda de dados. Libere espaço em disco antes de gravar novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись остановлена и сохранена, чтобы избежать потери данных. Освободите место на диске перед новой записью."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为防止数据丢失，录制已停止并保存。请先释放磁盘空间再重新录制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
