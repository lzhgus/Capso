    },
    "Your R2 account is at its storage limit. Free up space in the Cloudflare dashboard or upgrade your plan." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein R2-Account hat sein Speicherlimit erreicht. Gib im Cloudflare-Dashboard Speicher frei oder wechsle zu einem größeren Tarif."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta de R2 ha alcanzado su límite de almacenamiento. Libera espacio en el panel de Cloudflare o mejora tu plan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte R2 a atteint sa limite de stockage. Libérez de l'espace dans le tableau de bord Cloudflare ou passez à une offre supérieure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account R2 ha raggiunto il limite di archiviazione. Libera spazio nella dashboard di Cloudflare o aggiorna il piano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "R2 アカウントがストレージの上限に達しました。Cloudflare ダッシュボードでスペースを解放するか、プランをアップグレードしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "R2 계정의 저장 공간이 가득 찼습니다. Cloudflare 대시보드에서 공간을 확보하거나 플랜을 업그레이드하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua conta do R2 atingiu o limite de armazenamento. Libere espaço no painel do Cloudflare ou faça upgrade do seu plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В вашей учетной записи R2 достигнут лимит хранилища. Освободите место в панели управления Cloudflare или смените тариф."
