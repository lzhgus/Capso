    "Files live in your account. Cancel Capso, keep your screenshots." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Dateien liegen in deinem Account. Kündige Capso, behalte deine Bildschirmfotos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos están en tu cuenta. Aunque dejes Capso, conservas tus capturas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers restent dans votre compte. Arrêtez d'utiliser Capso, gardez vos captures d'écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file restano nel tuo account. Anche se smetti di usare Capso, le istantanee restano tue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
