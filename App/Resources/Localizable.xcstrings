    "Copying the %@ to the clipboard failed. The recording is still available in the preview — close this dialog and try Copy again, or use Save." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieren von %@ in die Zwischenablage fehlgeschlagen. Die Aufzeichnung ist weiterhin in der Vorschau verfügbar – schließe diesen Dialog und versuche erneut „Kopieren“ oder verwende „Sichern“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido copiar %@ al portapapeles. La grabación sigue disponible en la vista previa: cierra este cuadro de diálogo y vuelve a probar Copiar, o usa Guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie de %@ dans le presse-papiers a échoué. L'enregistrement est toujours disponible dans l'aperçu — fermez cette fenêtre et réessayez Copier, ou utilisez Enregistrer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile copiare %@ negli appunti. La registrazione è ancora disponibile nell'anteprima: chiudi questa finestra e riprova Copia, oppure usa Salva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ をクリップボードにコピーできませんでした。録画はプレビューに残っています。このダイアログを閉じてもう一度コピーするか、保存を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을(를) 클립보드에 복사하지 못했습니다. 녹화는 미리보기에서 계속 사용할 수 있습니다. 이 대화상자를 닫고 다시 복사하거나 저장을 사용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível copiar o %@ para a área de transferência. A gravação continua disponível na pré-visualização — feche esta caixa de diálogo e tente Copiar novamente, ou use Salvar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось скопировать %@ в буфер обмена. Запись по-прежнему доступна в предпросмотре — закройте это окно и снова нажмите «Скопировать» или используйте «Сохранить»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法将%@复制到剪贴板。录制内容仍可在预览中使用 — 请关闭此对话框后再次尝试复制，或使用保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法將%@拷貝到剪貼簿。錄製內容仍可在預覽中使用 — 請關閉此對話框後再試一次拷貝，或使用儲存。"
          }
        }
      }
    },
    "Copying the %@ to the clipboard failed. Try Copy from History, or export it again from the editor." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieren von %@ in die Zwischenablage fehlgeschlagen. Versuche „Kopieren“ im Verlauf oder exportiere erneut aus dem Editor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido copiar %@ al portapapeles. Prueba Copiar desde el historial o vuelve a exportarlo desde el editor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie de %@ dans le presse-papiers a échoué. Essayez Copier depuis l'historique, ou exportez-le à nouveau depuis l'éditeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile copiare %@ negli appunti. Prova Copia dalla cronologia o esportalo di nuovo dall'editor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ をクリップボードにコピーできませんでした。履歴からコピーするか、エディタからもう一度書き出してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
