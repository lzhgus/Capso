    "It sent this command:\n%@\n\nAllow other apps to start captures and recordings with Capso? You can change this later in Settings → General." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie hat diesen Befehl gesendet:\n%@\n\nAnderen Apps erlauben, mit Capso Aufnahmen und Aufzeichnungen zu starten? Du kannst das später unter Einstellungen → Allgemein ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha enviado este comando:\n%@\n\n¿Permitir que otras apps inicien capturas y grabaciones con Capso? Puedes cambiarlo más tarde en Ajustes → General."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle a envoyé cette commande :\n%@\n\nAutoriser d'autres apps à lancer des captures et des enregistrements avec Capso ? Vous pourrez modifier ce choix plus tard dans Réglages → Général."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha inviato questo comando:\n%@\n\nConsentire ad altre app di avviare catture e registrazioni con Capso? Puoi modificarlo in seguito in Impostazioni → Generali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次のコマンドが送信されました:\n%@\n\n他のアプリが Capso でキャプチャや録画を開始することを許可しますか？この設定は後で 設定 → 一般 で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 명령을 보냈습니다:\n%@\n\n다른 앱이 Capso로 캡처 및 녹화를 시작하도록 허용하시겠습니까? 나중에 설정 → 일반에서 변경할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele enviou este comando:\n%@\n\nPermitir que outros apps iniciem capturas e gravações com o Capso? Você pode alterar isso depois em Ajustes → Geral."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оно отправило эту команду:\n%@\n\nРазрешить другим приложениям запускать снимки и записи с помощью Capso? Это можно изменить позже в разделе Настройки → Основные."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它发送了以下命令：\n%@\n\n允许其他 App 通过 Capso 开始截图和录制吗？你之后可以在“设置” → “通用”中更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它傳送了以下指令：\n%@\n\n要允許其他 App 透過 Capso 開始擷取和錄製嗎？你之後可以在「設定」→「一般」中更改。"
          }
        }
      }
    },
