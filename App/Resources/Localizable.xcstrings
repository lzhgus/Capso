        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 정보는 이 Mac의 macOS 키체인에 저장되며, 내 버킷 이외에는 어디에도 전송되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
