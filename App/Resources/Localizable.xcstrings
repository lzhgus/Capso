    "These are stored in macOS Keychain on this Mac and never sent anywhere except your bucket." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie werden im macOS-Schlüsselbund auf diesem Mac gespeichert und nur an deinen Bucket gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guardan en el llavero de macOS de este Mac y nunca se envían a ningún sitio salvo a tu bucket."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils sont stockés dans le trousseau macOS de ce Mac et ne sont jamais envoyés ailleurs qu'à votre bucket."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono archiviate nel Portachiavi di macOS su questo Mac e non vengono mai inviate altrove, se non al tuo bucket."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの情報はこの Mac の macOS キーチェーンに保存され、あなたのバケット以外には送信されません。"
